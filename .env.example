# ═══════════════════════════════════════════════════════════════
# Acceleron Project+ — Environment Variables
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ═══════════════════════════════════════════════════════════════

# ─── Session signing (REQUIRED) ─────────────────────────────────
# The session cookie is HMAC-signed with this key. Without it, a user
# could edit their own cookie and grant themselves the admin role.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value signs everyone out.

SESSION_SECRET=

# ─── Database (REQUIRED) ────────────────────────────────────────
# Used by the app and by the migration/seed scripts in src/lib.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
# Set to true for managed Postgres (Neon, RDS, Azure); leave unset locally.
# DATABASE_SSL=false

# Database names — override only if yours differ from the defaults.
# DATABASE_IDENTITY_NAME=identity_db
# DATABASE_PROJECT_NAME=project_db
# DATABASE_ITSM_NAME=itsm_db
# DATABASE_EXECUTION_NAME=execution_db

# Connection pool sizing.
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Default tenant used when seeding baseline roles.
# DEFAULT_TENANT_ID=10000000-0000-0000-0000-000000000001

# ─── Darwinbox Integration ──────────────────────────────────────
# These were previously hardcoded in src/lib/darwinbox.ts — an API key,
# a dataset key and a Basic auth password for a live HR system. Move
# the real values into .env.local; do not commit them.
#
# Obtain from: Darwinbox Admin → Settings → API Management

DARWINBOX_MASTER_API_URL=https://yourcompany.darwinbox.in/masterapi/employee
DARWINBOX_API_KEY=
DARWINBOX_DATASET_KEY=
DARWINBOX_API_USERNAME=
DARWINBOX_API_PASSWORD=

# Which group companies to import. The master API returns every company
# in the group, so without this the employee master fills up with people
# from other entities. Comma-separated; defaults to ASPL.
DARWINBOX_COMPANY_CODES=ASPL

# The whole Darwinbox record is kept in employee_master.raw_payload so an
# unmapped field is never lost — except anything matching these patterns.
# Matching is substring, case-insensitive, and these ADD to the built-in
# list (salary, ctc, pan, aadhaar, passport, bank, ifsc, uan, date_of_birth…).
# DARWINBOX_REDACT_FIELDS=

# ─── Email Notifications (Nodemailer) ───────────────────────────
# For billing milestone alerts, magic link emails, etc.
# Use SMTP or a service like SendGrid / Mailgun.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@acceleron.in
SMTP_PASS=your_app_password
SMTP_FROM="Acceleron Project+ <no-reply@acceleron.in>"

# ─── Zoho CRM Integration ───────────────────────────────────────
# For lead sync (OAuth flow — obtain from Zoho API Console)

ZOHO_CRM_CLIENT_ID=your_zoho_client_id
ZOHO_CRM_CLIENT_SECRET=your_zoho_client_secret
ZOHO_CRM_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_CRM_BASE_URL=https://www.zohoapis.in/crm/v3

# ─── Sign-in: one-time codes ────────────────────────────────────
# Sign-in is: enter your email → receive a 6-digit code → enter it.
# No password is required. The password machinery is still in place;
# set AUTH_REQUIRE_PASSWORD=true to ask for it alongside the code.

# AUTH_OTP_ENABLED=true
# AUTH_REQUIRE_PASSWORD=false
# AUTH_PASSWORD_LOGIN_ENABLED=false     # re-enables the old /api/auth/login

# Code behaviour
# AUTH_OTP_TTL_SECONDS=300              # how long a code lasts
# AUTH_OTP_MAX_ATTEMPTS=5               # wrong guesses before the code is burned
# AUTH_OTP_RESEND_COOLDOWN=30           # seconds between resends
# AUTH_OTP_MAX_PER_WINDOW=6             # codes per account...
# AUTH_OTP_WINDOW_SECONDS=900           # ...within this many seconds

# Show the code on the sign-in screen instead of only emailing it.
# This is ignored entirely when NODE_ENV=production — revealing a code
# there would hand any account to anyone who knows an email address.
# Set to false if you want dev builds to email like production does.
# AUTH_OTP_DEV_REVEAL=true

# How the code reaches the user:
#   screen — shown on the sign-in page and printed to the terminal
#   email  — emailed only
#   both   — emailed and shown
# Defaults to "screen" in development and "email" in production.
# Production ignores anything but "email".
# AUTH_OTP_DELIVERY=screen

# NOTE: with no SMTP_* settings, a production build cannot send codes and
# sign-in will fail by design. Development builds fall back to showing the
# code on screen and printing it to the terminal.

# ─── Scheduled notification sweep ───────────────────────────────
# Overdue-milestone alerts have no request to hang off, so a scheduler
# calls POST /api/notifications/sweep once a day with this token:
#   curl -X POST http://localhost:3000/api/notifications/sweep \
#        -H "x-sweep-token: <this value>"
# Leave blank to require an admin/PM login for that endpoint instead.

NOTIFICATION_SWEEP_TOKEN=

# ─── App Config ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAGIC_LINK_EXPIRY_HOURS=72

# ─── Serving from a folder (production on APPLSRV) ──────────────
# The app is served as https://apps.acceleronsolutions.io/acceleron-plus/.
# Baked into the build — set BEFORE `next build` / deploy.sh, and leave
# unset on a laptop. See src/lib/base-path.ts and DEPLOY.md.
# NEXT_PUBLIC_BASE_PATH=/acceleron-plus
# Links in emails; include the folder when NEXT_PUBLIC_BASE_PATH is set.
# NEXT_PUBLIC_APP_URL=https://apps.acceleronsolutions.io/acceleron-plus
